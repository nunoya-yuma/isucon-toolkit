# Trusted shell configuration. Keep secrets in existing remote environment files.
TK_HOSTS='contest-1'
TK_ROLE_app='contest-1'
APP_DIR=/home/isucon/webapp
APP_USER=isucon
APP_SERVICE=myapp
BUILD_CMD='go build -o app .'
# READY_URL: an app endpoint that answers without login and touches the app (not a static file nginx serves).
# READY_HOST: set it when the app or nginx routes by the Host header (otherwise leave empty).
# READY_CODES: the codes that mean "the app is up" for that endpoint (e.g. 401 for an auth-only API).
READY_URL=http://127.0.0.1:8080/health
READY_HOST=
READY_CODES='200 401'
READY_TIMEOUT=60
# Optional; one profiler port checked on every selected host (empty: do not check).
FINAL_PROFILER_PORT=
REBOOT_TIMEOUT=300
