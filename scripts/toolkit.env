# Per-contest settings, sourced by every script. Copy this next to the scripts and edit it.
# Values below are for ISUCON14.

# --- deploy.sh ---
APP_DIR=/home/isucon/webapp            # repo root on the server
BUILD_DIR=$APP_DIR/go
BUILD_CMD="go build -o isuride"
APP_SERVICE=isuride-go
ENV_FILE=/home/isucon/env.sh           # sourced before build (some contests put the toolchain on PATH here)
DB_NAME=isuride                        # migrations/*.sql in the repo are applied to this DB
# Fetched after restart to show the status. Use a path that the app itself serves (any 4xx is fine,
# 502 means the app is down): / is often a static file that nginx returns even with the app down,
# and http://localhost/ may hit nginx's default_server instead.
HEALTH_URL=https://isuride.xiv.isucon.net/api/app/notification

# --- logs.sh ---
NGINX_LOG=/var/log/nginx/access.log
SLOW_LOG=/var/log/mysql/mysql-slow.log
# Regexes that alp uses to group URIs with IDs into one row
ALP_MATCHING='^/api/app/rides/[0-9A-Z]+/evaluation$,^/api/chair/rides/[0-9A-Z]+/status$,^/assets/.+'

# --- profile.sh ---
PPROF_ADDR=localhost:6060
