# Per-contest settings, sourced by every script. Copy this next to the scripts and edit it.
# Values below are for private-isu.

# --- deploy.sh ---
APP_DIR=/home/isucon/private_isu       # repo root on the server
BUILD_DIR=$APP_DIR/webapp/golang
BUILD_CMD="go build -o app"
APP_SERVICE=isu-go
ENV_FILE=/home/isucon/env.sh           # sourced before build to get the toolchain on PATH
DB_NAME=isuconp                        # sql/*.sql in the repo are applied to this DB

# --- logs.sh ---
NGINX_LOG=/var/log/nginx/access.log
SLOW_LOG=/var/log/mysql/mysql-slow.log
# Regexes that alp uses to group URIs with IDs into one row
ALP_MATCHING='^/posts/[0-9]+$,^/@[a-zA-Z0-9_]+$,^/image/[0-9]+\.(jpg|png|gif)$'

# --- profile.sh ---
PPROF_ADDR=localhost:6060
