#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
task=${1:-help}
case "$task" in
  help|-h|--help)
    echo 'Usage: tk status [--detail] [host...|@app]'
    echo '       tk deploy [--plan] <commit|branch> [host|@app]'
    echo 'status: remote read only; deploy: checkout/config/build/restart (no migrations)'
    exit 0;;
  status|deploy) shift;;
  *) echo "NG: unknown task: $task" >&2; exit 2;;
esac
if [[ ${1:-} == --help ]]; then
  bash "$root/tasks/$task.sh" --help
  exit 0
fi
source "$root/lib/common.sh"
tk_load_config
bash "$root/tasks/$task.sh" "$@"
